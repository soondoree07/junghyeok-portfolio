# 학습 섹션 서버 설정. Vercel 프로젝트 환경변수에 넣는다 (이 파일은 예시일 뿐, 실제 값은 커밋하지 않는다)

# 기록 편집 로그인 비밀번호
STUDY_PASSWORD=

# 세션 쿠키 서명용 임의 문자열 (32자 이상). 예: openssl rand -base64 48
STUDY_SESSION_SECRET=

# Upstash Redis. Vercel 마켓플레이스로 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN 이 자동으로 들어오며 그것도 읽는다
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
